+    state=ctx.engine.state;w0,w1=state.workflows_by_id.values()
+    assert w0.id==0 and w1.id==1 and w0.owner_device is state.mobile_devices[0]
+    assert [t.id for t in w0.tasks]==[t.id for t in w1.tasks]
