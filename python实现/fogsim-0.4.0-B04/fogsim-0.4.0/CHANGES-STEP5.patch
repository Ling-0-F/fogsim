+                 for score,observation in zip(d['candidates'],d['candidate_state'])]
+        selected=next(o for o in options if [o['workflow_id'],state.workflows_by_id[o['workflow_id']].tasks[o['task_java_index']].id,o['resource_id']]==d['selected'])
