+class Draws:
+    def __init__(self,ints=(),reals=()):self.ints=list(ints);self.reals=list(reals);self.bounds=[]
+    def randrange(self,start,stop=None):
+        if stop is None:start,stop=0,start
+        self.bounds.append([start,stop]);x=self.ints.pop(0)
