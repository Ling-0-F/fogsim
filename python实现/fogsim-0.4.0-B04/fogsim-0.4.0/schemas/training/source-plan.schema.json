{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fogsim.local/schema/training/source-plan.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "fogsim.training-source-plan"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "run_id",
          "config"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "entries"
  ],
  "additionalProperties": false
}
