{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fogsim.local/schema/training/plan.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "fogsim.training-plan"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "const": "dynamic"
              },
              "seed": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "effective_config": {
                "type": "object"
              },
              "template_digests": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "lifecycle": {
                "enum": [
                  "fresh_dynamic_same_plan",
                  "fresh_fixed",
                  "fresh_replay"
                ]
              },
              "input_contract": {
                "type": "string"
              },
              "source_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "scene_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "input_family_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "input_content_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "templates": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              }
            },
            "required": [
              "run_id",
              "mode",
              "seed",
              "effective_config",
              "template_digests",
              "lifecycle",
              "input_contract",
              "source_config_sha256",
              "scene_id",
              "input_family_id",
              "input_content_id",
              "effective_config_sha256",
              "templates"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "fixed",
                  "replay"
                ]
              },
              "seed": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "effective_config": {
                "type": "object"
              },
              "template_digests": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "lifecycle": {
                "enum": [
                  "fresh_dynamic_same_plan",
                  "fresh_fixed",
                  "fresh_replay"
                ]
              },
              "input_contract": {
                "type": "string"
              },
              "source_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "scene_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "input_family_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "input_content_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "input": {
                "type": "object"
              }
            },
            "required": [
              "run_id",
              "mode",
              "seed",
              "effective_config",
              "template_digests",
              "lifecycle",
              "input_contract",
              "source_config_sha256",
              "scene_id",
              "input_family_id",
              "input_content_id",
              "effective_config_sha256",
              "input"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "lifecycle": {
      "const": "fresh_dynamic_same_plan"
    },
    "failure_policy": {
      "const": "all_success_feasible_v1"
    },
    "aggregation": {
      "const": "run_equal_mean"
    },
    "limits": {
      "type": "object",
      "properties": {
        "wallclock_seconds_per_run": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "dataset_role": {
      "enum": [
        "train",
        "debug",
        "test"
      ]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "schema_version",
    "split",
    "entries",
    "lifecycle",
    "failure_policy",
    "aggregation",
    "limits",
    "dataset_role",
    "plan_id"
  ],
  "additionalProperties": false,
  "description": "Importer recomputes every digest, validates B08 configs/inputs and mode/lifecycle/split mappings."
}
